{
  "permissions": {
    "allow": [
      "Bash(pre-commit run *)",
      "Bash(pre-commit --version *)",
      "Bash(git fetch *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git show *)",
      "Bash(gh run *)",
      "Bash(gh repo *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(grep *)",
      "Bash(just test-hw *)",
      "Bash(just install *)",
      "Bash(.venv/bin/pyright *)",
      "Bash(.venv/bin/pip list *)",
      "Bash(.venv/bin/pip show *)",
      "Bash(.venv/bin/python --version)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:groups.google.com)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-bash-guard",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '[.tool_input.questions[]?.question] | join(\" / \")' | { read -r body; [ -n \"$CLAUDE_HEADLESS\" ] || $HOME/.local/bin/alert \"Claude Code: question\" \"${body:0:200}\"; }",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/busy block",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_HEADLESS\" ] || $HOME/.local/bin/alert \"Claude Code: compacted\" \"context compacted — waiting for you\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/busy mark",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-suspend-notice",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_HEADLESS\" ] || $HOME/.local/bin/busy active || $HOME/.local/bin/alert \"Claude Code: done\"",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/busy unmark",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-pr-watch stop",
            "timeout": 60
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '(.error // \"error\") + (if .last_assistant_message then \": \" + .last_assistant_message else \"\" end)' | { read -r body; [ -n \"$CLAUDE_HEADLESS\" ] || $HOME/.local/bin/alert \"Claude Code: turn failed\" \"${body:0:200}\"; }",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/busy unmark && $HOME/.local/bin/busy block",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/busy unmark --all",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-suspend-notice end",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/busy mark --sub",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/busy unmark --sub",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '(.tool_name // \"tool\") + (if (.tool_input.command // .tool_input.file_path) then \": \" + (.tool_input.command // .tool_input.file_path) else \"\" end)' | { read -r body; [ -n \"$CLAUDE_HEADLESS\" ] || $HOME/.local/bin/alert \"Claude Code: permission request\" \"${body:0:200}\"; }",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/busy block",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/busy unblock",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-suspend-notice",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-pr-watch record",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/busy unblock",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-suspend-notice",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/claude-pr-watch record",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_HEADLESS\" ] || $HOME/.local/bin/sway-session note-claude",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "awaySummaryEnabled": false,
  "theme": "auto",
  "editorMode": "vim"
}
