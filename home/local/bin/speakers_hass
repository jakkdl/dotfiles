#!/bin/sh
# If sulfur is outputting to the speakers, switch the LinkPlay to line in and
# turn on the subwoofer. Run on alt+m (after toggle_default_sink) and on resume.
[ "$(cat /etc/hostname)" = sulfur ] || exit 0
[ "$(pactl get-default-sink)" = alsa_output.pci-0000_0e_00.6.analog-stereo ] || exit 0

. ~/.config/zsh/hass_token
U=http://192.168.1.100:8123/api/services

hass() {
    curl -s -m5 -o /dev/null -H "Authorization: Bearer $HASS_TOKEN" \
        -H "Content-Type: application/json" "$U/$1" -d "$2"
}

hass media_player/select_source \
    '{"entity_id": "media_player.soundsystem_1bba", "source": "Line In"}'
hass switch/turn_on \
    '{"entity_id": "switch.ikea_of_sweden_tradfri_control_outlet_switch"}'
