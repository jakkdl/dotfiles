#!/usr/bin/python
# Pinned to the system interpreter, NOT `env python`, so it always finds the
# pacman-installed i3ipc even when launched from a terminal with a venv active
# (an activated venv normally shadows `python` and won't have i3ipc).
"""Tint waybar workspaces: green while work runs, teal for ones parked by hand.

Subcommands:
  mark / unmark   set or clear the marker for the calling terminal
                  (--sub counts a subagent of the owner instead; the terminal
                  stays marked while any subagent is still running)
  unmark --all    clear the marker and the subagent count (session over)
  active          exit 0 while the calling claude still has subagents or
                  `run` commands going, 1 once it is truly idle
  run CMD...      hold the marker for as long as CMD runs
  later           toggle "get back to this" on the focused workspace
  daemon          keep the generated waybar stylesheet in sync with both

A marker is a file in $XDG_RUNTIME_DIR/busy, named after the process that owns
it (the enclosing claude, or the calling shell) and holding the pid of the
terminal window it runs in; it lives only as long as its owner. Subagents are
tallied next to it in <owner>.subs, one "+" or "-" line per start or stop —
appends, because start and stop hooks for parallel subagents overlap and a
read-modify-write would race. A later mark is a workspace name in
$XDG_STATE_HOME/busy/later, and stays until toggled off, including across a
reboot.

The daemon maps marked terminal pids to workspaces through the sway tree and
writes one rule per tinted workspace into ~/.config/waybar/busy.css, which
style.css imports. waybar swaps that stylesheet in on the fly, without the
flicker a SIGUSR2 reset would cause; it needs "reload_style_on_change" and the
working directory waybar-busy gives it.

No workspace is tinted for two reasons at once: urgent wins over both, so the
red of something waiting on you (see `alert`) is never painted over, and work
running wins over a later mark, which comes back when the work finishes.
"""

from __future__ import annotations

import argparse
import asyncio
import contextlib
import json
import os
import signal
import subprocess
import sys
import time
import traceback
from collections.abc import Iterator
from pathlib import Path
from typing import TYPE_CHECKING

if TYPE_CHECKING:
    from i3ipc import Con
    from i3ipc.aio import Connection

RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
MARKERS = RUNTIME / "busy"
PIDFILE = MARKERS / "daemon.pid"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
LATER = STATE / "busy/later"  # one workspace name per line
LOG = STATE / "busy/daemon.log"  # the daemon's stderr is a tty, so errors go here
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
CSS = CONFIG / "waybar/busy.css"
HEADER = "/* generated by `busy`; edits are overwritten */\n"

# Terminals whose pid sway reports for the window; the marker is pinned to one
# of these rather than to the shell, since only they appear in the sway tree.
TERMINALS = {"foot", "footclient", "alacritty", "kitty"}
RESYNC = 5.0  # seconds; backstop for a missed signal or event

# --- process tree ------------------------------------------------------------


def proc_comm(pid: int) -> str:
    """Command name of pid, empty if it is gone."""
    with contextlib.suppress(OSError):
        return Path(f"/proc/{pid}/comm").read_text().strip()
    return ""


def parent_pid(pid: int) -> int:
    """Parent of pid, 0 if it is gone. Field 1 after comm in stat is ppid."""
    with contextlib.suppress(OSError, IndexError, ValueError):
        stat = Path(f"/proc/{pid}/stat").read_text()
        return int(stat[stat.rindex(")") + 1 :].split()[1])
    return 0


def ancestry(pid: int) -> Iterator[int]:
    """pid and its ancestors, stopping short of init."""
    for _ in range(40):  # bound the walk against a pathological chain
        yield pid
        pid = parent_pid(pid)
        if pid <= 1:
            return


def owner_and_terminal() -> tuple[int, int] | None:
    """(pid the marker belongs to, pid of the terminal window it runs in).

    The owner is the enclosing claude where there is one, so the marker
    outlives the hook process that set it and dies with the session; otherwise
    it is the calling shell. Returns None when no terminal is in the ancestry
    (ssh, headless), where there is no workspace to mark.
    """
    owner = os.getppid()
    found_claude = False
    for pid in ancestry(os.getpid()):
        comm = proc_comm(pid)
        if comm == "claude" and not found_claude:
            owner, found_claude = pid, True
        if comm in TERMINALS:
            return owner, pid
    return None


def log(msg: str) -> None:
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        # keep the log from growing unbounded
        if LOG.exists() and LOG.stat().st_size > 1_000_000:
            LOG.write_text(LOG.read_text()[-200_000:])
        with LOG.open("a") as f:
            f.write(f"{time.strftime('%F %T')} {msg}\n")
    except OSError:
        pass


# --- markers -----------------------------------------------------------------


def poke() -> None:
    """Nudge the daemon to re-render now rather than at its next resync."""
    with contextlib.suppress(OSError, ValueError):
        os.kill(int(PIDFILE.read_text()), signal.SIGUSR1)


def mark(owner: int, terminal: int) -> None:
    MARKERS.mkdir(parents=True, exist_ok=True)
    (MARKERS / str(owner)).write_text(f"{terminal}\n")
    poke()


def unmark(owner: int, everything: bool = False) -> None:
    with contextlib.suppress(OSError):
        (MARKERS / str(owner)).unlink()
    if everything:
        with contextlib.suppress(OSError):
            (MARKERS / f"{owner}.subs").unlink()
    poke()


def sub_mark(owner: int, terminal: int, done: bool) -> None:
    """Tally a subagent of owner starting (or, done, finishing)."""
    MARKERS.mkdir(parents=True, exist_ok=True)
    with (MARKERS / f"{owner}.subs").open("a") as f:
        f.write("-\n" if done else f"+ {terminal}\n")
    poke()


def sub_terminal(tally: str) -> int | None:
    """The terminal pid from a .subs tally, None unless subagents are running.

    Clamped at zero: a stop without its start (hooks added mid-session, a
    start hook that died) must not cancel out a later, real one.
    """
    count = 0
    terminal = None
    for line in tally.splitlines():
        if line.startswith("+"):
            count += 1
            terminal = int(line.split()[1])
        elif line.startswith("-"):
            count = max(0, count - 1)
    return terminal if count > 0 else None


def marked_terminals() -> set[int]:
    """Terminal pids of every marker whose owner is still alive.

    Markers left behind by a killed owner are dropped here: nothing else
    cleans them up, and the terminal they name usually outlives the owner.
    """
    terminals: set[int] = set()
    for marker in MARKERS.glob("[0-9]*"):
        if not Path("/proc", marker.name.partition(".")[0]).exists():
            with contextlib.suppress(OSError):
                marker.unlink()
            continue
        with contextlib.suppress(OSError, ValueError, IndexError):
            if marker.name.endswith(".subs"):
                terminal = sub_terminal(marker.read_text())
                if terminal is not None:
                    terminals.add(terminal)
            else:
                terminals.add(int(marker.read_text()))
    return terminals


# --- later marks -------------------------------------------------------------


def read_later() -> set[str]:
    with contextlib.suppress(OSError):
        return {line for line in LATER.read_text().splitlines() if line}
    return set()


def write_later(names: set[str]) -> None:
    with contextlib.suppress(OSError):
        LATER.parent.mkdir(parents=True, exist_ok=True)
        LATER.write_text("".join(f"{name}\n" for name in sorted(names)))


def follow_renames(workspaces: list[Con], seen: dict[int, str]) -> set[str]:
    """The later marks, moved along with any workspace that was renamed.

    Marks are stored by name so they outlive a reboot and land back on the
    workspace sway-session restores. A rename would strand them, so the
    workspace id — stable for as long as sway runs — ties old name to new.
    """
    later = read_later()
    moved = False
    for workspace in workspaces:
        was = seen.get(workspace.id)
        seen[workspace.id] = workspace.name
        if was is not None and was != workspace.name and was in later:
            later.discard(was)
            later.add(workspace.name)
            moved = True
    if moved:
        write_later(later)
    return later


def focused_workspace() -> str | None:
    """Name of the focused workspace, or None if sway did not say."""
    with contextlib.suppress(OSError, ValueError, subprocess.SubprocessError):
        out = subprocess.run(
            ["swaymsg", "-t", "get_workspaces", "--raw"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout
        for workspace in json.loads(out):
            if workspace.get("focused"):
                return str(workspace["name"])
    return None


# --- stylesheet --------------------------------------------------------------


def css_ident(name: str) -> str:
    """Escape a workspace name for a GTK CSS id selector.

    Names are free-form ("9 cam_service*"), so everything outside the
    identifier characters gets a backslash.
    """
    return "".join(c if c.isalnum() or c in "-_" else "\\" + c for c in name)


def write_css(text: str) -> None:
    """Write the stylesheet, skipping the write when nothing changed.

    Every write is a waybar reload, so an unchanged render must not cause one.
    """
    with contextlib.suppress(OSError):
        if CSS.exists() and CSS.read_text() == text:
            return
        CSS.parent.mkdir(parents=True, exist_ok=True)
        CSS.write_text(text)


def rules(names: set[str], color: str) -> str:
    return "".join(
        f"#workspaces button#sway-workspace-{css_ident(name)} "
        f"{{ background-color: @{color}; }}\n"
        for name in sorted(names)
    )


async def render(ipc: Connection, seen: dict[int, str]) -> None:
    """Rewrite the stylesheet from the marks and the current sway tree."""
    tree = await ipc.get_tree()
    workspaces = tree.workspaces()
    later = follow_renames(workspaces, seen)
    urgent = {workspace.name for workspace in workspaces if workspace.urgent}
    terminals = marked_terminals()
    busy: set[str] = set()
    if terminals:
        for con in tree:
            workspace = con.workspace()
            if con.pid in terminals and workspace:
                busy.add(workspace.name)
    busy -= urgent
    later -= urgent | busy
    write_css(HEADER + rules(busy, "busy") + rules(later, "later"))


# --- subcommands -------------------------------------------------------------


def cmd_mark(clear: bool, sub: bool = False, everything: bool = False) -> int:
    where = owner_and_terminal()
    if where is None:
        return 0
    owner, terminal = where
    if sub:
        sub_mark(owner, terminal, done=clear)
    elif clear:
        unmark(owner, everything)
    else:
        mark(owner, terminal)
    return 0


def cmd_active() -> int:
    """Exit 0 while the calling claude still has work in flight.

    In flight means a positive subagent tally, or a `run` marker whose owner
    descends from this claude (a watcher it started in the background). Lets
    the Stop hook hold the done-alert until the last of them has finished.
    """
    where = owner_and_terminal()
    if where is None:
        return 1
    owner, _ = where
    with contextlib.suppress(OSError, ValueError, IndexError):
        if sub_terminal((MARKERS / f"{owner}.subs").read_text()) is not None:
            return 0
    for marker in MARKERS.glob("[0-9]*"):
        if "." in marker.name:
            continue
        pid = int(marker.name)
        if pid != owner and owner in ancestry(pid):
            return 0
    return 1


def cmd_run(argv: list[str]) -> int:
    """Run argv with the marker held, and hand back its exit status."""
    where = owner_and_terminal()
    owner = os.getpid()  # the marker lives exactly as long as this process
    if where is not None:
        mark(owner, where[1])
    try:
        return subprocess.call(argv)
    except OSError as exc:
        print(f"busy: {argv[0]}: {exc.strerror}", file=sys.stderr)
        return 127
    finally:
        if where is not None:
            unmark(owner)


def cmd_later(show: bool) -> int:
    """Toggle the later mark on the focused workspace, or list the marks.

    Marks for workspaces that do not exist right now are kept, not pruned: a
    workspace closed and later restored under the same name gets its mark
    back, which is the point of the thing.
    """
    later = read_later()
    if show:
        print("\n".join(sorted(later)))
        return 0
    name = focused_workspace()
    if name is None:
        print("busy: no focused workspace", file=sys.stderr)
        return 1
    later.symmetric_difference_update({name})
    write_later(later)
    poke()
    return 0


async def resync(ipc: Connection, wake: asyncio.Event) -> None:
    """Render on every wake-up until sway is gone; never die to an exception.

    A failed render here means auto-reconnect could not revive the connection
    (sway closes one now and then, seen around a suspend). Whether sway itself
    is gone is what its socket path says: still there means this was a hiccup
    worth logging and outliving, gone means it is time to exit.
    """
    seen: dict[int, str] = {}  # workspace id -> name, for spotting renames
    while True:
        try:
            await render(ipc, seen)
        except Exception:
            if not Path(ipc.socket_path).exists():
                return
            log(f"render failed:\n{traceback.format_exc()}")
        with contextlib.suppress(TimeoutError):
            await asyncio.wait_for(wake.wait(), RESYNC)
        wake.clear()


async def cmd_daemon() -> int:
    # Imported here, not at the top: mark/unmark/run are the paths a claude
    # hook takes, and they must keep working on a box without i3ipc (or
    # without sway at all), where they simply find no terminal to mark.
    from i3ipc import Event
    from i3ipc.aio import Connection

    # Events that can move a marked terminal to another workspace, rename the
    # workspace under it, or change whether that workspace is urgent. Urgency
    # is cleared by focusing, hence the focus event.
    events = (
        Event.WINDOW_MOVE,
        Event.WINDOW_CLOSE,
        Event.WINDOW_URGENT,
        Event.WORKSPACE_RENAME,
        Event.WORKSPACE_URGENT,
        Event.WORKSPACE_FOCUS,
    )

    MARKERS.mkdir(parents=True, exist_ok=True)
    PIDFILE.write_text(f"{os.getpid()}\n")
    log(f"daemon started, pid {os.getpid()}")
    # auto_reconnect makes the library redial and resubscribe when sway closes
    # a connection out from under us, rather than fail every call forever.
    # There is no ipc.main() here: events arrive through a socket reader that
    # connect() registers on the event loop, main() only waits for an error,
    # and when to exit is resync's call (on the socket path disappearing).
    ipc = await Connection(auto_reconnect=True).connect()
    wake = asyncio.Event()
    asyncio.get_running_loop().add_signal_handler(signal.SIGUSR1, wake.set)
    for event in events:
        ipc.on(event, lambda *_: wake.set())
    await resync(ipc, wake)
    write_css(HEADER)  # leave no workspace tinted behind
    log("sway went away, exiting")
    return 0


# --- cli ---------------------------------------------------------------------


def main() -> None:
    p = argparse.ArgumentParser(description="tint workspaces in waybar")
    sub = p.add_subparsers(dest="cmd", required=True)
    pm = sub.add_parser("mark", help="mark the calling terminal's workspace")
    pm.add_argument("--sub", action="store_true", help="count a subagent starting")
    pu = sub.add_parser("unmark", help="clear the calling terminal's marker")
    pu.add_argument("--sub", action="store_true", help="count a subagent finishing")
    pu.add_argument("--all", action="store_true", help="also drop the subagent count")
    sub.add_parser("active", help="exit 0 while subagents or run commands are going")
    pr = sub.add_parser("run", help="hold the marker while CMD runs")
    pr.add_argument("argv", nargs=argparse.REMAINDER, metavar="CMD")
    pl = sub.add_parser("later", help="toggle the focused workspace's later mark")
    pl.add_argument("--list", action="store_true", help="print the marks instead")
    sub.add_parser("daemon", help="keep the stylesheet in sync (sway exec)")

    args = p.parse_args()
    if args.cmd == "run":
        if not args.argv:
            p.error("run needs a command")
        sys.exit(cmd_run(args.argv))
    elif args.cmd == "later":
        sys.exit(cmd_later(show=args.list))
    elif args.cmd == "active":
        sys.exit(cmd_active())
    elif args.cmd == "daemon":
        sys.exit(asyncio.run(cmd_daemon()))
    else:
        sys.exit(
            cmd_mark(
                clear=args.cmd == "unmark",
                sub=args.sub,
                everything=getattr(args, "all", False),
            )
        )


if __name__ == "__main__":
    main()
